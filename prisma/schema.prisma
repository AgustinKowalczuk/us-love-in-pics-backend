generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum BoardStatus {
  ACTIVE
  ARCHIVED
}

enum BoardMemberRole {
  OWNER
  PARTNER
}

enum BoardMemberStatus {
  ACTIVE
  ARCHIVED
}

enum MediaType {
  PHOTO
  GIF
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  name            String    @db.VarChar(100)
  email           String    @unique @db.VarChar(255)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  sentInvitations         Invitation[]             @relation("InvitationSender")
  receivedInvitations     Invitation[]             @relation("InvitationRecipient")
  boardMemberships        BoardMember[]
  memories                Memory[]
  emailVerificationTokens EmailVerificationToken[]

  @@map("users")
}

model Invitation {
  id             String           @id @default(uuid()) @db.Uuid
  senderId       String           @map("sender_id") @db.Uuid
  recipientId    String?          @map("recipient_id") @db.Uuid
  recipientEmail String           @map("recipient_email") @db.VarChar(255)
  tokenHash      String           @unique @map("token_hash") @db.VarChar(64)
  tokenEncrypted String           @map("token_encrypted") @db.Text
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime         @map("expires_at")
  acceptedAt     DateTime?        @map("accepted_at")
  respondedAt    DateTime?        @map("responded_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  sender    User   @relation("InvitationSender", fields: [senderId], references: [id], onDelete: Restrict)
  recipient User?  @relation("InvitationRecipient", fields: [recipientId], references: [id], onDelete: SetNull)
  board     Board?

  @@index([senderId, status])
  @@index([recipientEmail, status])
  @@index([expiresAt, status])
  @@map("invitations")
}

model Board {
  id           String      @id @default(uuid()) @db.Uuid
  name         String      @db.VarChar(201)
  status       BoardStatus @default(ACTIVE)
  photoLimit   Int         @default(15) @map("photo_limit")
  invitationId String?     @unique @map("invitation_id") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  archivedAt   DateTime?   @map("archived_at")

  invitation Invitation?   @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  members    BoardMember[]
  memories   Memory[]

  @@index([status, createdAt])
  @@map("boards")
}

model BoardMember {
  id         String            @id @default(uuid()) @db.Uuid
  boardId    String            @map("board_id") @db.Uuid
  userId     String            @map("user_id") @db.Uuid
  role       BoardMemberRole
  status     BoardMemberStatus @default(ACTIVE)
  joinedAt   DateTime          @default(now()) @map("joined_at")
  archivedAt DateTime?         @map("archived_at")

  board Board @relation(fields: [boardId], references: [id], onDelete: Restrict)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([boardId, userId])
  @@index([userId, status])
  @@index([boardId, status])
  @@map("board_members")
}

model Memory {
  id         String   @id @default(uuid()) @db.Uuid
  boardId    String   @map("board_id") @db.Uuid
  authorId   String   @map("author_id") @db.Uuid
  memoryDate DateTime @map("memory_date") @db.Date
  position   Int
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  board  Board         @relation(fields: [boardId], references: [id], onDelete: Restrict)
  author User          @relation(fields: [authorId], references: [id], onDelete: Restrict)
  media  MemoryMedia[]
  notes  MemoryNote[]

  @@unique([boardId, position])
  @@index([boardId, memoryDate])
  @@index([authorId])
  @@map("memories")
}

model MemoryMedia {
  id          String    @id @default(uuid()) @db.Uuid
  memoryId    String    @map("memory_id") @db.Uuid
  mediaType   MediaType @map("media_type")
  storageKey  String    @map("storage_key") @db.VarChar(500)
  takenAt     DateTime? @map("taken_at") @db.Date
  description String?   @db.VarChar(500)
  position    Int
  createdAt   DateTime  @default(now()) @map("created_at")

  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@unique([memoryId, position])
  @@index([memoryId, mediaType])
  @@map("memory_media")
}

model MemoryNote {
  id        String   @id @default(uuid()) @db.Uuid
  memoryId  String   @map("memory_id") @db.Uuid
  text      String   @db.VarChar(1000)
  position  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@unique([memoryId, position])
  @@map("memory_notes")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model UserSession {
  sid    String   @id(map: "session_pkey") @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("user_sessions")
}
